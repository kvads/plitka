# Name of an EXISTING Docker network shared with PostgreSQL.
POSTGRES_NETWORK=shared
# PostgreSQL container name or network alias (not localhost).
PGHOST=postgres
PGPORT=5432
# Existing shared database; provision a dedicated role and schema inside it.
PGDATABASE=apps
PGUSER=plitka
# Required: fill in the real password before starting.
PGPASSWORD=
PGSSLMODE=prefer
PGOPTIONS='-c search_path=plitka'
APP_IMAGE=plitka:production
APP_BIND=127.0.0.1
APP_PORT=8080
